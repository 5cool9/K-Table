<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 알레르기 선택 카드 공통 스타일 -->
    <style name="AllergyCardStyle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">95dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_margin">6dp</item>
        <item name="android:background">@drawable/bg_allergy_card</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- 카드 안의 이미지 스타일 -->
    <style name="AllergyImageStyle">
        <item name="android:layout_width">20dp</item>
        <item name="android:layout_height">20dp</item>

    </style>

    <!-- 카드 안의 텍스트 스타일 -->
    <style name="AllergyTextStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">#5B5A5A</item>
        <item name="android:fontFamily">bold</item>
    </style>

    <style name="MypageCardShape" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">16dp</item>
        <item name="cornerSizeTopRight">16dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>
</resources>