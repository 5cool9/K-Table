<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <ImageView
        android:id="@+id/resultImage"
        android:layout_width="0dp"
        android:layout_height="0dp"

        android:scaleType="fitCenter"

        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomButtons"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <View
        android:id="@+id/dimOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#66000000"

        app:layout_constraintTop_toTopOf="@id/resultImage"
        app:layout_constraintBottom_toBottomOf="@id/resultImage"
        app:layout_constraintStart_toStartOf="@id/resultImage"
        app:layout_constraintEnd_toEndOf="@id/resultImage"/>


    <!-- 상단 텍스트 영역 -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="메뉴판을 스캔 중 .."
        android:textStyle="bold"
        android:textSize="20sp"
        android:textColor="#FFFFFF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="90dp" />

    <TextView
        android:id="@+id/tvSub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="음식을 스캔하고 있습니다."
        android:textColor="#D1D1D6"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTitle" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/scanFrame"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipChildren="true"
        android:clipToPadding="true"

        app:layout_constraintWidth_percent="0.90"
        app:layout_constraintDimensionRatio="3:4"

        app:layout_constraintTop_toBottomOf="@id/tvSub"
        app:layout_constraintBottom_toTopOf="@id/bottomButtons"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"

        android:layout_marginTop="40dp"
        android:layout_marginBottom="40dp">

        <!-- 좌측 상단 모서리 (가로선) -->
        <View
            android:layout_width="32dp"
            android:layout_height="2dp"
            android:background="#FFAA19"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />
        <!-- 좌측 상단 모서리 (세로선) -->
        <View
            android:layout_width="2dp"
            android:layout_height="32dp"
            android:background="#FFAA19"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- 우측 상단 모서리 (가로선) -->
        <View
            android:layout_width="32dp"
            android:layout_height="2dp"
            android:background="#FFAA19"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
        <!-- 우측 상단 모서리 (세로선) -->
        <View
            android:layout_width="2dp"
            android:layout_height="32dp"
            android:background="#FFAA19"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- 좌측 하단 모서리 (가로선) -->
        <View
            android:layout_width="32dp"
            android:layout_height="2dp"
            android:background="#FFAA19"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />
        <!-- 좌측 하단 모서리 (세로선) -->
        <View
            android:layout_width="2dp"
            android:layout_height="32dp"
            android:background="#FFAA19"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- 우측 하단 모서리 (가로선) -->
        <View
            android:layout_width="32dp"
            android:layout_height="2dp"
            android:background="#FFAA19"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
        <!-- 우측 하단 모서리 (세로선) -->
        <View
            android:layout_width="2dp"
            android:layout_height="32dp"
            android:background="#FFAA19"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <View
            android:id="@+id/scanLine"

            android:layout_width="0dp"
            android:layout_height="4dp"
            android:background="@drawable/bg_scan_line"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"

            app:layout_constraintTop_toTopOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 하단 촬영, 갤러리 부분 -->
    <LinearLayout
        android:id="@+id/bottomButtons"
        android:layout_width="0dp"
        android:layout_height="104dp"
        android:background="#222222"
        android:elevation="20dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="48dp"
        android:paddingEnd="48dp"
        android:paddingBottom="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:alpha="0.5"
        android:clickable="false"
        android:focusable="false">

        <!-- 갤러리 버튼 영역 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="10dp">

            <ImageButton
                android:id="@+id/btnGallery"
                android:layout_width="27dp"
                android:layout_height="27dp"
                android:elevation="30dp"
                android:background="@android:color/transparent"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_gallery"
                android:contentDescription="갤러리"
                android:enabled="false"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="갤러리"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:layout_marginTop="6dp"
                android:enabled="false"/>
        </LinearLayout>

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- 중앙 촬영 버튼 -->
        <ImageButton
            android:id="@+id/btnCapture"
            android:layout_width="55dp"
            android:layout_height="55dp"
            android:background="@android:color/transparent"
            android:scaleType="centerCrop"
            android:src="@drawable/capture_button"
            android:contentDescription="촬영"
            android:enabled="false"/>

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- 우측 균형 맞추기용 뷰 -->
        <View
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:visibility="invisible" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>