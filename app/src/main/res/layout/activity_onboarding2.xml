<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- Skip -->
    <TextView
        android:id="@+id/txtSkip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Skip"
        android:textSize="15sp"
        android:textColor="#666666"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Personalized -->
    <TextView
        android:id="@+id/txtGreen"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Personalized"
        android:textStyle="bold"
        android:textSize="35sp"
        android:textColor="#028334"
        android:layout_marginStart="30dp"
        android:layout_marginTop="100dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <!-- Recommendations -->
    <TextView
        android:id="@+id/txtBlack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Recommendations"
        android:textStyle="bold"
        android:textSize="35sp"
        android:textColor="#2D2F34"
        app:layout_constraintStart_toStartOf="@id/txtGreen"
        app:layout_constraintTop_toBottomOf="@id/txtGreen"/>

    <!-- Description -->
    <TextView
        android:id="@+id/txtDesc"
        android:layout_width="290dp"
        android:layout_height="wrap_content"
        android:text="Get tailored food and restaurant recommendations that fit your diet and preferences."
        android:textColor="#7A7A7A"
        android:textSize="20sp"
        android:layout_marginTop="18dp"
        app:layout_constraintStart_toStartOf="@id/txtGreen"
        app:layout_constraintTop_toBottomOf="@id/txtBlack"/>


    <ImageView
        android:id="@+id/imgFood"
        android:layout_width="0dp"
        android:layout_height="420dp"
        android:layout_marginTop="84dp"
        android:scaleType="centerCrop"
        android:src="@drawable/onboarding_food"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtDesc" />

    <Button
        android:id="@+id/btnNext"
        android:layout_width="280dp"
        android:layout_height="55dp"
        android:text="Next"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:backgroundTint="#0A8F3D"
        android:translationY="-35dp"
        app:cornerRadius="28dp"
        app:layout_constraintBottom_toTopOf="@id/layoutDots"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- 페이지 표시 -->
    <LinearLayout
        android:id="@+id/layoutDots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_margin="4dp"
            />

        <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_margin="4dp"
            />

        <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_margin="4dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>