<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white">

    <!-- 스크롤 가능한 본문 영역 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 상단 로고 영역 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="30dp"
                android:paddingStart="24dp">

                <ImageView
                    android:layout_width="79dp"
                    android:layout_height="31dp"
                    android:scaleType="fitStart"
                    android:src="@drawable/home_logo" />
            </LinearLayout>

            <!-- 검색창 및 위치 버튼 레이아웃 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="18dp">

                <!-- 검색창 -->
                <EditText
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/rounded_edittext"
                    android:hint="메뉴를 검색해보세요 !"
                    android:paddingHorizontal="16dp"
                    android:textColorHint="#BBBBBB"
                    android:textColor="#111111"
                    android:textSize="13sp"
                    android:drawableStart="@drawable/ic_menu_search"
                    android:drawablePadding="8dp"/>

                <!-- 위치 버튼 -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnLocation"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:layout_marginStart="5dp"
                    android:background="@drawable/rounded_button"
                    android:drawableStart="@drawable/ic_menu_mylocation"
                    android:paddingHorizontal="12dp"
                    android:text="위치"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 오늘의 추천 식당 타이틀 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="오늘의 추천 식당"
                android:textColor="#342D2D"
                android:textSize="18sp"
                android:textStyle="bold"
                android:paddingStart="24dp"/>

            <!-- 오늘의 추천 식당 가로 슬라이드 -->
            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/viewPagerToday"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginTop="12dp" />

            <!-- 프로모션 배너 -->
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:layout_marginTop="20dp"
                android:scaleType="centerCrop"
                android:src="@drawable/banner_sample" />

            <!-- 맞춤 추천 타이틀 -->
            <TextView
                android:id="@+id/tvUserRecommendTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="오늘은 여기 어떠신가요?"
                android:textColor="#342D2D"
                android:textSize="18sp"
                android:textStyle="bold"
                android:paddingStart="24dp" />


            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="80dp">

            <!-- 식당 리스트 -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvRestaurantList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"/>

                <!-- 로딩 화면 -->
                <LinearLayout
                    android:id="@+id/layoutLoading"
                    android:layout_width="match_parent"
                    android:layout_height="250dp"
                    android:background="@android:color/white"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="visible"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">


                    <ProgressBar
                        android:id="@+id/progressLoading"
                        android:layout_width="110dp"
                        android:layout_height="110dp"
                        android:indeterminateDrawable="@drawable/progress_loading"/>


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="식당 정보를 불러오는 중이에요."
                        android:textColor="#212529"
                        android:textSize="20sp"
                        android:textStyle="bold"/>


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="사용자의 정보를 기반으로\n추천 식당을 확인 중입니다."
                        android:gravity="center"
                        android:textColor="#7A7A7A"
                        android:textSize="14sp"/>
                </LinearLayout>

                <!-- 실패 화면 -->
                <LinearLayout
                    android:id="@+id/layoutError"
                    android:layout_width="match_parent"
                    android:layout_height="350dp"
                    android:background="@android:color/white"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="gone">


                    <ImageView
                        android:id="@+id/imgError"
                        android:layout_width="160dp"
                        android:layout_height="160dp"
                        android:src="@drawable/error_image"
                        android:scaleType="fitCenter"/>


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="추천 식당 정보를 불러오지 못했어요."
                        android:textColor="#212529"
                        android:textSize="20sp"
                        android:textStyle="bold"/>


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="네트워크 응답이 없거나 일시적인 오류가 발생했어요.\n잠시 후 다시 시도해주세요."
                        android:gravity="center"
                        android:textColor="#7A7A7A"
                        android:textSize="14sp"/>
                </LinearLayout>

            </FrameLayout>

        </LinearLayout>
    </ScrollView>


</androidx.constraintlayout.widget.ConstraintLayout>