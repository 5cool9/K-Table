<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="4dp"
    app:cardCornerRadius="10dp"
    app:cardElevation="2dp"
    app:cardUseCompatPadding="true"
    app:cardBackgroundColor="#FBFBFB">

    <LinearLayout
        android:id="@+id/cardContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="25dp"
        android:paddingTop="27dp"
        android:paddingEnd="20dp"
        android:paddingBottom="27dp">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="346dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvKoreanName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#212529"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        tools:text="불고기 덮밥" />

                    <ImageView
                        android:id="@+id/statusDot"
                        android:layout_width="13dp"
                        android:layout_height="13dp"
                        android:layout_marginStart="6dp"
                        android:src="@drawable/ic_dot" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvEnglishName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:textColor="#7A7A7A"
                    android:textSize="14sp"
                    tools:text="Bulgogi Rice Bowl" />
            </LinearLayout>

            <ImageView
                android:id="@+id/ivChevron"
                android:layout_width="18dp"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_chevron_down" />
        </LinearLayout>

        <!-- 펼친 상태: 질문 영역 -->
        <LinearLayout
            android:id="@+id/expandableContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="14dp"
            android:paddingHorizontal="0dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="18px">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_question_mark" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="사장님께 이렇게 물어보세요"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#000000" />

                <!-- 언어 선택  -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_listen_button"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp">


                    <TextView
                        android:id="@+id/tvLanguage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🇰🇷 한국어"
                        android:textSize="10sp"
                        android:textColor="#7A7A7A"/>


                    <ImageView
                        android:layout_width="8dp"
                        android:layout_height="12dp"
                        android:layout_marginStart="4dp"
                        android:src="@drawable/ic_arrow_down_small"/>

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_question_box"
                android:padding="14dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvQuestion"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="12sp"
                    android:textColor="#000000"
                    android:lineSpacingExtra="2dp"
                    tools:text="갈비 양념에 청주나 맛술이 들어가나요?\n알코올을 없이 조리해 주실 수 있나요?" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnListen"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="8dp"
                    android:text="음성 듣기"
                    android:textSize="10sp"
                    android:textColor="#212529"
                    android:background="@drawable/bg_listen_button"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    app:icon="@drawable/ic_speaker"
                    app:backgroundTint="@null"
                    app:iconTint="@null"
                    app:minHeight="0dp"
                    app:minWidth="0dp"
                    app:strokeWidth="0dp"
                    app:iconPadding="4dp" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>