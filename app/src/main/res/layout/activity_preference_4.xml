<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <!-- 상단 바 -->
        <LinearLayout
            android:id="@+id/layoutTopBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="8dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_back"
                android:contentDescription="Back"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/signup_step_4"
                android:textColor="#1B1C1E"
                android:textSize="17sp"
                android:textStyle="bold"
                android:layout_marginStart="12dp" />
        </LinearLayout>

        <!-- 타이틀 및 설명 -->
        <LinearLayout
            android:id="@+id/layoutTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="40dp"
            app:layout_constraintTop_toBottomOf="@id/layoutTopBar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="기본 정보를 입력해 주세요."
                android:textColor="#2D2F34"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/allergy_subtitle"
                android:textColor="#7A7A7A"
                android:textSize="16sp"
                android:layout_marginTop="15dp" />
        </LinearLayout>

        <!-- 모든 알레르기 목록 -->
        <GridLayout
            android:id="@+id/gridDefaultAllergy"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:columnCount="3"
            android:alignmentMode="alignMargins"
            android:columnOrderPreserved="false"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/layoutTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:rowOrderPreserved="false">

            <!-- 기본 알레르기 8개 -->
            <LinearLayout style="@style/AllergyCardStyle" android:id="@+id/cardPeanuts"><ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ic_peanuts" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textSize="14sp" android:textColor="#5B5A5A" android:textStyle="bold" android:text="@string/allergy_peanuts" /></LinearLayout>
            <LinearLayout style="@style/AllergyCardStyle" android:id="@+id/cardTreeNuts"><ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ic_treenuts" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textSize="14sp" android:textColor="#5B5A5A" android:textStyle="bold" android:text="@string/allergy_tree_nuts" /></LinearLayout>
            <LinearLayout style="@style/AllergyCardStyle" android:id="@+id/cardMilk"><ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ic_milk" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textSize="14sp" android:textColor="#5B5A5A" android:textStyle="bold" android:text="@string/allergy_milk" /></LinearLayout>
            <LinearLayout style="@style/AllergyCardStyle" android:id="@+id/cardEggs"><ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ic_eggs" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textSize="14sp" android:textColor="#5B5A5A" android:textStyle="bold" android:text="@string/allergy_eggs" /></LinearLayout>
            <LinearLayout style="@style/AllergyCardStyle" android:id="@+id/cardSeafood"><ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ic_seafood" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textSize="14sp" android:textColor="#5B5A5A" android:textStyle="bold" android:text="@string/allergy_seafood" /></LinearLayout>
            <LinearLayout style="@style/AllergyCardStyle" android:id="@+id/cardWheat"><ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ic_wheat" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textSize="14sp" android:textColor="#5B5A5A" android:textStyle="bold" android:text="@string/allergy_wheat" /></LinearLayout>
            <LinearLayout style="@style/AllergyCardStyle" android:id="@+id/cardSoy"><ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ic_soy" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textSize="14sp" android:textColor="#5B5A5A" android:textStyle="bold" android:text="@string/allergy_soy" /></LinearLayout>
            <LinearLayout style="@style/AllergyCardStyle" android:id="@+id/cardSesame"><ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ic_sesame" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textSize="14sp" android:textColor="#5B5A5A" android:textStyle="bold" android:text="@string/allergy_sesame" /></LinearLayout>

            <LinearLayout style="@style/AllergyCardStyle" android:id="@+id/cardOther"><ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ic_other" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textSize="14sp" android:textColor="#5B5A5A" android:textStyle="bold" android:text="@string/allergy_other" /></LinearLayout>
            <!-- 세부 알레르기 카드들 (처음엔 전부 숨김 처리) -->
            <LinearLayout style="@style/AllergyCardStyle" android:id="@+id/cardCorn" android:visibility="gone"><ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ic_corn" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textSize="14sp" android:textColor="#5B5A5A" android:textStyle="bold" android:text="@string/allergy_corn" /></LinearLayout>
            <LinearLayout style="@style/AllergyCardStyle" android:id="@+id/cardChicken" android:visibility="gone"><ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ic_chicken" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textSize="14sp" android:textColor="#5B5A5A" android:textStyle="bold" android:text="@string/allergy_chicken" /></LinearLayout>
            <LinearLayout style="@style/AllergyCardStyle" android:id="@+id/cardBeef" android:visibility="gone"><ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ic_beef" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textSize="14sp" android:textColor="#5B5A5A" android:textStyle="bold" android:text="@string/allergy_beef" /></LinearLayout>
            <LinearLayout style="@style/AllergyCardStyle" android:id="@+id/cardPork" android:visibility="gone"><ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ic_pork" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textSize="14sp" android:textColor="#5B5A5A" android:textStyle="bold" android:text="@string/allergy_pork" /></LinearLayout>
            <LinearLayout style="@style/AllergyCardStyle" android:id="@+id/cardTomato" android:visibility="gone"><ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ic_tomato" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textSize="14sp" android:textColor="#5B5A5A" android:textStyle="bold" android:text="@string/allergy_tomato" /></LinearLayout>
            <LinearLayout style="@style/AllergyCardStyle" android:id="@+id/cardMushroom" android:visibility="gone"><ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ic_mushroom" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textSize="14sp" android:textColor="#5B5A5A" android:textStyle="bold" android:text="@string/allergy_mushroom" /></LinearLayout>
            <LinearLayout style="@style/AllergyCardStyle" android:id="@+id/cardCoconut" android:visibility="gone"><ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ic_coconut" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textSize="14sp" android:textColor="#5B5A5A" android:textStyle="bold" android:text="@string/allergy_coconut" /></LinearLayout>
            <LinearLayout style="@style/AllergyCardStyle" android:id="@+id/cardKiwi" android:visibility="gone"><ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ic_kiwi" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textSize="14sp" android:textColor="#5B5A5A" android:textStyle="bold" android:text="@string/allergy_kiwi" /></LinearLayout>
            <LinearLayout style="@style/AllergyCardStyle" android:id="@+id/cardPeach" android:visibility="gone"><ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ic_peach" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textSize="14sp" android:textColor="#5B5A5A" android:textStyle="bold" android:text="@string/allergy_peach" /></LinearLayout>
            <LinearLayout style="@style/AllergyCardStyle" android:id="@+id/cardBanana" android:visibility="gone"><ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ic_banana" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textSize="14sp" android:textColor="#5B5A5A" android:textStyle="bold" android:text="@string/allergy_banana" /></LinearLayout>
            <LinearLayout style="@style/AllergyCardStyle" android:id="@+id/cardGarlic" android:visibility="gone"><ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ic_garlic" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textSize="14sp" android:textColor="#5B5A5A" android:textStyle="bold" android:text="@string/allergy_garlic" /></LinearLayout>
            <LinearLayout style="@style/AllergyCardStyle" android:id="@+id/cardOnion" android:visibility="gone"><ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ic_onion" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textSize="14sp" android:textColor="#5B5A5A" android:textStyle="bold" android:text="@string/allergy_onion" /></LinearLayout>
            <LinearLayout style="@style/AllergyCardStyle" android:id="@+id/cardSpices" android:visibility="gone"><ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ic_spices" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textSize="14sp" android:textColor="#5B5A5A" android:textStyle="bold" android:text="@string/allergy_spices" /></LinearLayout>

        </GridLayout>

        <!-- None 버튼 -->
        <TextView
            android:id="@+id/btnNone"
            android:layout_width="0dp"
            android:layout_height="66dp"
            android:layout_marginTop="15dp"
            android:background="@drawable/bg_selectable_card"
            android:gravity="center"
            android:text="@string/allergy_none"
            android:textColor="#028334"
            android:textSize="18sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintTop_toBottomOf="@id/gridDefaultAllergy"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- 안내 텍스트 -->
        <TextView
            android:id="@+id/tvSettingsNotice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/update_settings_msg"
            android:textColor="#7A7A7A"
            android:textSize="15sp"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/btnNone"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- 하단 Complete 버튼 -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnComplete"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_green_button"
            android:text="@string/btn_complete"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"
            app:layout_constraintTop_toBottomOf="@id/tvSettingsNotice"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>